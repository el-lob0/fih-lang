// comment

 

type Index: u32

type Person: struct {
    age: int,
    name: string,
}

signal fihh

signal {
    success
    failure
}


fn hello_world(name: Person): u8 { 
  // a foreign package's signal should not be returned
  // read the exterior signal and then return your own from the first point of contact
  
    println("hello world ", name)
    return success
}

fn not_hello_world(name: Person, times: u32): u8 { 
    println("hello world ", name)
    return success
}


run {
    
    max: u32 = 10

    loop (i := 0) < max {
        if i == (2 | 3) {
            result := hello_world("fih")

            if result == failure {
                paragraph := ```an error
                and uhh another line```

                print(paragraph)
            }
        }
    }
}
